#!/bin/bash
# setup.env - Environment setup for running fkmob benchmarks with skmob comparison
#
# IMPORTANT: Python version matters!
# This script MUST be run with Python 3.10 because:
# - skmob uses shapely.ops.cascaded_union (removed in Shapely 2.0)
# - Older Python versions have wheels built with compatible library versions
#
# Usage:
#   # First-time: create venv with Python 3.10
#   rm -rf .venv
#   python3.10 -m venv .venv
#   source .venv/bin/activate
#   bash setup.env
#
#   # Afterwards:
#   source .venv/bin/activate
#

set -e

if [ -z "$VIRTUAL_ENV" ]; then
    echo "ERROR: Virtual environment not activated."
    echo "Please activate with: source .venv/bin/activate"
    exit 1
fi

python_version=$(python --version | cut -d' ' -f2 | cut -d'.' -f1,2)
if [[ "$python_version" != "3.10" ]]; then
    echo "WARNING: Using Python $python_version (expected 3.10)"
    echo "This may cause compatibility issues with skmob."
fi

echo "Setting up fkmob benchmark environment..."
echo "Python: $(python --version)"

# Install core dependencies
echo "Installing development dependencies..."
pip install -e ".[dev]" 2>&1 | grep -E "Successfully|ERROR|WARNING" | head -5

# Install shapely <2.0 (required for skmob's cascaded_union)
echo "Installing shapely <2.0 (required for skmob)..."
pip install 'shapely<2.0' 2>&1 | grep -E "Successfully|already" | head -1

# Install scikit-mobility
echo "Installing scikit-mobility..."
pip install 'scikit-mobility' 2>&1 | grep -E "Successfully|already" | head -1

# Fix numpy/pandas compatibility (if needed)
echo "Ensuring numpy/pandas compatibility..."
pip install 'numpy<2.0' 'pandas>=1.5.3,<2.0' 2>&1 | grep -E "Successfully|already" | head -1

# Verify skmob import
echo ""
echo "Verifying installations..."
python -c "from skmob.measures.individual import jump_lengths; print('✓ skmob: OK')" || echo "✗ skmob: FAILED"
python -c "import fkmob; print('✓ fkmob: OK')" || echo "✗ fkmob: FAILED"

echo ""
echo "✓ Environment setup complete!"
echo ""
echo "To run benchmarks:"
echo "  bash scripts/run_benchmarks.sh           # all sizes"
echo "  bash scripts/run_benchmarks.sh -k 1k     # 1k rows only"
echo ""
echo "To save results:"
echo "  bash scripts/run_benchmarks.sh --benchmark-json=results.json"
